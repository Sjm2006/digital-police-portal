# Placeholders only. Copy to .env and fill in real values. Never commit .env.
APP_ENV=development            # development | production
APP_DEBUG=true                 # must be false in production
APP_NAME="Digital Police Portal"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=digital_police_portal
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Exact origin of the React app (scheme + host + port, no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173

# Session / cookie settings
SESSION_NAME=dpp_session
SESSION_LIFETIME=1800          # idle timeout in seconds
SESSION_SAMESITE=Lax           # Lax for same-site subdomains; None only if truly cross-site (requires HTTPS)
SESSION_SECURE=false           # true in production (HTTPS)
SESSION_DOMAIN=                # e.g. .example.com in production, empty locally

# Private file storage. Use an absolute path OUTSIDE the web root in production.
STORAGE_PATH=./storage/private
UPLOAD_MAX_BYTES=5242880       # 5 MB
